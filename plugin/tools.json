[
  {
    "type": "function",
    "function": {
      "name": "godmode_auto",
      "description": "Run the full automatic evaluation flow: baseline, model-family strategy order, strategy-plus-prefill retry, Parseltongue escalation, scoring, persistence, and optional race fallback.",
      "parameters": {
        "type": "object",
        "properties": {
          "canary": {"type": "string", "description": "Optional custom canary; defaults to the built-in canary."},
          "prompt": {"type": "string", "description": "Backward-compatible alias for canary."},
          "model_id": {"type": "string", "description": "Defaults to the current agent model."},
          "dry_run": {"type": "boolean", "default": false},
          "max_tokens": {"type": "integer", "minimum": 64, "maximum": 4096, "default": 2048},
          "race_on_failure": {"type": "boolean", "default": false},
          "race_backend": {"type": "string", "enum": ["evonic", "openrouter"], "default": "evonic"},
          "race_tier": {"type": "string", "enum": ["fast", "standard", "smart", "power", "ultra"], "default": "standard"},
          "fallback_model_ids": {"type": "array", "items": {"type": "string"}, "maxItems": 55}
        }
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "godmode_transform",
      "description": "Detect trigger words and generate the complete 11/22/33-technique prompt transformation tiers without executing prompts.",
      "parameters": {
        "type": "object",
        "properties": {
          "prompt": {"type": "string"},
          "tier": {"type": "string", "enum": ["light", "standard", "heavy"], "default": "standard"},
          "limit": {"type": "integer", "minimum": 1, "maximum": 33, "default": 22},
          "technique": {"type": "string", "enum": ["raw", "leetspeak", "unicode", "bubble", "spaced", "fullwidth", "zwj", "mixedcase", "semantic", "dotted", "underscored", "reversed", "superscript", "smallcaps", "morse", "piglatin", "brackets", "mathbold", "mathitalic", "strikethrough", "leetheavy", "hyphenated", "leetunicode", "spacedmixed", "reversedleet", "bubblespaced", "unicodezwj", "base64hint", "hexencode", "acrostic", "dottedunicode", "fullwidthmixed", "triplelayer"]},
          "custom_triggers": {"type": "array", "items": {"type": "string"}},
          "escalation_level": {"type": "integer", "minimum": 0, "maximum": 4}
        },
        "required": ["prompt"]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "godmode_score",
      "description": "Apply full hard-refusal, hedge, quality, structure, specificity, and query-relevance scoring.",
      "parameters": {
        "type": "object",
        "properties": {
          "response": {"type": "string"},
          "query": {"type": "string"},
          "latency_ms": {"type": "integer", "minimum": 0, "default": 0}
        },
        "required": ["response"]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "godmode_profile",
      "description": "Enable, inspect, persist, disable, or remove a complete per-agent strategy payload.",
      "parameters": {
        "type": "object",
        "properties": {
          "action": {"type": "string", "enum": ["status", "enable", "disable", "undo"]},
          "strategy": {"type": "string"},
          "model_family": {"type": "string"},
          "system_prompt": {"type": "string"},
          "prefill": {"type": "array", "items": {"type": "object", "properties": {"role": {"type": "string", "enum": ["user", "assistant"]}, "content": {"type": "string", "minLength": 1, "maxLength": 16000}}, "required": ["role", "content"]}, "maxItems": 8},
          "encoding": {"type": "string"},
          "custom_context": {"type": "string", "maxLength": 8000}
        },
        "required": ["action"]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "godmode_race",
      "description": "Run ULTRAPLINIAN tier racing or the five GODMODE Classic combinations using OpenRouter or enabled Evonic models.",
      "parameters": {
        "type": "object",
        "properties": {
          "prompt": {"type": "string"},
          "query": {"type": "string", "description": "Alias for prompt."},
          "backend": {"type": "string", "enum": ["evonic", "openrouter"], "default": "evonic"},
          "race_type": {"type": "string", "enum": ["ultraplinian", "classic"], "default": "ultraplinian"},
          "tier": {"type": "string", "enum": ["fast", "standard", "smart", "power", "ultra"], "default": "standard"},
          "model_ids": {"type": "array", "items": {"type": "string"}, "maxItems": 55},
          "strategy": {"type": "string"},
          "system_prompt": {"type": "string"},
          "append_directive": {"type": "boolean", "default": true},
          "max_workers": {"type": "integer", "minimum": 1, "maximum": 20, "default": 10},
          "timeout": {"type": "integer", "minimum": 5, "maximum": 300, "default": 60},
          "max_tokens": {"type": "integer", "minimum": 64, "maximum": 4096, "default": 4096}
        },
        "required": ["prompt"]
      }
    }
  }
]
